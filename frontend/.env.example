# Copie para .env e preencha. Nunca commite o .env.
# Sem VITE_AUTH0_DOMAIN e VITE_AUTH0_CLIENT_ID, o `npm run dev` usa um usuário fictício.

# Auth0 > Applications > (sua Single Page Application) > Settings
VITE_AUTH0_DOMAIN=seu-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=

# Auth0 > Applications > APIs > Identifier da API do backend
VITE_AUTH0_AUDIENCE=https://projeto.jonas-rocha.com/api

# Conexão de usuário e senha usada em "alterar senha"
VITE_AUTH0_DB_CONNECTION=Username-Password-Authentication
